/* Pywal Style Template for Waybar */
/* Update css in ~/.config/wal/templates/waybar-colors */

@define-color background {background};
@define-color foreground {foreground};
@define-color color0 {color0};
@define-color color1 {color1};
@define-color color2 {color2};
@define-color color3 {color3};
@define-color color4 {color4};
@define-color color5 {color5};
@define-color color6 {color6};
@define-color color7 {color7};
@define-color color8 {color8};
@define-color color9 {color9};
@define-color color10 {color10};
@define-color color11 {color11};
@define-color color12 {color12};
@define-color color13 {color13};
@define-color color14 {color14};
@define-color color15 {color15};





* {{
  font-family:
    "Noto Sans Medium", "CodeNewRoman Nerd Font Propo", "Symbols Nerd Font",
    "Nerd Font", sans-serif;
  font-weight: 600;
  font-size: 11pt;
  background: transparent;
}}

#left {{
  padding: 5px;
  background: alpha(@color1, 0.6);
  box-shadow: 0px 0px 2px rgba(0, 0, 0, 0.6);
  border-radius: 0 0 10px 0;
    margin: 0 0 6px 0;
}}

.modules-left {{
  margin: 0px 0 0 0px;
}}
.modules-center {{
    margin: 0 0 6px 0;
    background: alpha(@color1, 0.6);
  box-shadow: 0px 0px 2px rgba(0, 0, 0, 0.6);
  border-radius: 0 0 10px 10px;
  padding: 5px;
}}
.modules-right {{
  margin: 0px 0px 0 0;
}}
#right {{
  margin: 0 0 6px 0;
  padding: 5px;
  border-radius: 0 0 0 10px;
  background: alpha(@color1, 0.6);
  box-shadow: 0px 0px 2px rgba(0, 0, 0, 0.6);
}}
tooltip {{
  background: @color1;
  color: #ffffff;
    border-radius: 10px;
}}

#custom-notification {{
  padding: 0px 10px;
  transition: all 0.3s ease;
  color: #ffffff;
}}
#clock {{
  padding: 0px 5px;
  color: #ffffff;
  transition: all 0.3s ease;
  font-size: 10pt;
}}
#bluetooth {{
  padding: 0px 10px;
  transition: all 0.3s ease;
  color: #ffffff;
}}

#network {{
  padding: 0px 10px;
  transition: all 0.3s ease;
  color: #ffffff;
}}

#battery {{
  padding: 0px 10px;
  transition: all 0.3s ease;
  color: #26a65b;
}}
#battery.charging {{
  color: #26a65b;
}}

#battery.good {{
  color: #26a65b;
}}

#battery.warning {{
  color: #ffbe61;
}}

#battery.critical {{
  color: #f53c3c;
}}

@keyframes blink {{
  to {{
    color: black;
    font-size: 13pt;
  }}
}}
#group-expand {{
  transition: all 0.3s ease;
  padding: 2px;
}}
#custom-expand {{
  color: alpha(#ffffff, 0.8);
  text-shadow: 0px 0px 2px rgba(0, 0, 0, 0.7);
  transition: all 0.3s ease;
}}
#custom-expand:hover {{
  color: rgba(255, 255, 255, 0.8);
  text-shadow: 0px 0px 2px rgba(255, 255, 255, 0.5);
}}
#custom-colorpicker {{
  padding: 0px 10px;
}}
#cpu,
#memory,
#temperature {{
  padding: 0px 10px;
  transition: all 0.3s ease;
  color: #ffffff;
}}
#custom-endpoint {{
  color: alpha(#ffffff, 0.8);
  text-shadow: 0px 0px 1.5px rgba(0, 0, 0, 1);
}}
#tray {{
  padding: 0px 10px;
  transition: all 0.3s ease;
}}
#tray menu {{
  background: @color9;
}}

#tray menu separator {{
  padding: 0px 5px;
  transition: all 0.3s ease;
}}

#pulseaudio {{
  padding: 0px 5px;
}}

#clock:hover,
#custom-pacman:hover,
#custom-notification:hover,
#bluetooth:hover,
#network:hover,
#battery:hover,
#cpu:hover,
#memory:hover,
#temperature:hover,
#custom-power:hover,
#pulseaudio:hover {{
  transition: all 0.3s ease;
  color: @color9;
}}

#mpris {{
   font-size: 10pt;
  padding: 0 15px;
  margin-left: 120px;
  margin-bottom: 6px;
  border-radius: 0 0 10px 10px;
  background: alpha(@color1, 0.6);
  box-shadow: 0px 0px 2px rgba(0, 0, 0, 0.6);
}}
#mpris.playing,
#mpris.paused {{
  animation-name: slideDown;
  animation-duration: 1s;
  animation-timing-function: cubic-bezier(0.25, 1, 0.5, 1);
  animation-fill-mode: forwards;
}}

@keyframes slideDown {{
  0% {{
    margin-top: -40px;
    opacity: 0;
  }}
  100% {{
    margin-top: 0px;
    opacity: 1;
  }}
}}



#window {{
  border-radius: 10px;
  padding: 0 10px;
  margin-left: 10px;
  background: alpha(@background, 0.6);
  box-shadow: 0px 0px 2px rgba(0, 0, 0, 0.6);
}}
window#waybar.empty #window {{
  background: none;
  padding: 0;
}}

#workspaces button label {{
  font-size: 8pt;
}}

#workspaces button {{
  color: #ffffff;
  border-radius: 10px;
  padding: 0px;
  margin: 0 2px;
  background: alpha(@background, 0.6);
  box-shadow: 0px 0px 2px rgba(0, 0, 0, 0.6);
  animation: gradient_f 20s ease-in infinite;
  transition: all 0.2s cubic-bezier(0.55, -0.68, 0.48, 1.682);
  text-shadow: 0px 0px 2px rgba(0, 0, 0, 0.5);
}}
#workspaces button.active {{
  background: alpha(@color9, 0.6);
  min-width: 28px;
  border-radius: 18px;
  transition: all 0.2s cubic-bezier(0.55, -0.68, 0.48, 1.682);

}}
#workspaces button:hover {{
border-color: alpha(@color9, 0.3);
  background-color: alpha(@color9, 0.3);
}}

#custom-terminal {{
  padding: 0 15px 0 5px;
}}


